# Database: SQLite, embedded — no setup needed, backend/data/restyle.db is created automatically.

# Razorpay (Get test-mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Groq (free key from https://console.groq.com) — required for the buying/negotiation agents
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS + Razorpay payment-link callback)
FRONTEND_URL=http://localhost:5173
